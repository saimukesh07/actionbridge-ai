# ==============================================================================
# ActionBridge AI - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for live AI reasoning)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase Configuration (Optional for cloud auth and PostgreSQL persistence)
# If omitted, ActionBridge AI runs in local-development offline storage mode.
SUPABASE_URL=
SUPABASE_KEY=
